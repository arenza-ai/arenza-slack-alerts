# Arenza API token — generate at https://app.arenza.ai/settings/api
ARENZA_TOKEN=arz_live_paste_your_token_here

# Webhook signing secret — set this same value in app.arenza.ai/settings/notifications
ARENZA_WEBHOOK_SECRET=replace_with_a_long_random_string

# Slack bot OAuth token — copy from your Slack app's "OAuth & Permissions" page after install
SLACK_BOT_TOKEN=xoxb-paste-your-bot-token

# Default Slack channel to post into when no per-brand mapping exists
SLACK_DEFAULT_CHANNEL=#geo-alerts

# Optional: comma-separated event types to watch
# Defaults to: wrong_claim_detected,sov_drop
# Other options: mention_rate_change, competitor_added, opportunity_created, probe_completed
WATCH_EVENT_TYPES=wrong_claim_detected,sov_drop

# Optional: minimum severity to forward (low | medium | high | critical)
# Defaults to: medium
MIN_SEVERITY=medium

# Optional: HTTP port (defaults to 3000)
PORT=3000
